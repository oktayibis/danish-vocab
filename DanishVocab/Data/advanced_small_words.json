  {"id":"adv.s.109","danish":"sikkert","english":"probably, surely","partOfSpeech":"adverb","category":"adverbs","visual":{"type":"emoji","value":"🔮"},"exampleDa":"Det bliver sikkert regn.","exampleEn":"It will probably rain."},
