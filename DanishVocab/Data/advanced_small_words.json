  {"id":"adv.s.111","danish":"alene","english":"alone","partOfSpeech":"adverb","category":"adverbs","visual":{"type":"emoji","value":"🧍"},"exampleDa":"Bor du alene?","exampleEn":"Do you live alone?"},
