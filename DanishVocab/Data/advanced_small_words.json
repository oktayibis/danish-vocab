  {"id":"adv.s.124","danish":"som","english":"who, which, that; as, like","partOfSpeech":"conjunction","category":"conjunctions","visual":{"type":"emoji","value":"🔗"},"exampleDa":"Manden, som bor her, er læge.","exampleEn":"The man who lives here is a doctor."},

