  {"id":"adv.s.105","danish":"heller ikke","english":"not either, neither","partOfSpeech":"adverb","category":"adverbs","visual":{"type":"emoji","value":"🙅‍♂️"},"exampleDa":"Jeg kan heller ikke lide fisk.","exampleEn":"I don't like fish either."},
  {"id":"adv.s.106","danish":"især","english":"especially","partOfSpeech":"adverb","category":"adverbs","visual":{"type":"emoji","value":"⭐️"},"exampleDa":"Jeg elsker frugt, især jordbær.","exampleEn":"I love fruit, especially strawberries."},
