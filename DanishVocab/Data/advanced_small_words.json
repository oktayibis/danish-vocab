  {"id":"adv.s.115","danish":"at","english":"that","partOfSpeech":"conjunction","category":"conjunctions","note":"also the infinitive marker: at spise = to eat","visual":{"type":"emoji","value":"💬"},"exampleDa":"Jeg tror, at det regner.","exampleEn":"I think that it is raining."},
